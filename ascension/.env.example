# Local build settings, read by scripts\windows\env.ps1. Copy this file to
# .env (same folder) and change the paths to your PC. .env is never committed.
# Relative paths are relative to this folder (ascension\).

# The runtime (this repository's ps3kit folder) and the work folder that holds
# your own decrypted EBOOT.ELF (work\pristine\EBOOT.ELF) and what is made from it.
PS3KIT_DIR=../ps3kit
WORK_DIR=../work

# Visual Studio 2022 (Build Tools or any edition) with "Desktop development
# with C++" and "C++ Clang Compiler for Windows" (clang-cl).
VCVARS=C:\Program Files (x86)\Microsoft Visual Studio\2022\BuildTools\VC\Auxiliary\Build\vcvars64.bat

# FFmpeg, a *shared LGPL* build for Windows x64 (for example
# ffmpeg-n7.1-latest-win64-lgpl-shared-7.1 from github.com/BtbN/FFmpeg-Builds):
# its include\ folder (needed) and bin\ folder (its DLLs are copied beside the game).
FFMPEG_INCLUDE_DIR=C:\deps\ffmpeg\include
FFMPEG_BIN_DIR=C:\deps\ffmpeg\bin

# SDL2 for controllers: the cmake\ folder of the "SDL2-devel-2.x.y-VC.zip"
# package from github.com/libsdl-org/SDL/releases (optional; leave empty to
# build with XInput only).
SDL2_DIR=C:\deps\SDL2-2.32.10\cmake

BUILD_TYPE=Release
# Parallel compile jobs. The 12 translated PPU files are ~10 MB of C++ each:
# each compiler needs 2-4 GB of RAM, so keep JOBS at about RAM(GB) / 4.
JOBS=6

# Lifted SPU code options (what the releases used).
SPU_FMA=1
SPU_XFLOAT_APPROX=1
SPU_CODEGEN2=1

# Optional: a standalone LLVM bin\ folder (clang-cl, lld-link) put first on
# PATH, when Visual Studio's own Clang component is not installed.
# LLVM_BIN=C:\Program Files\LLVM\bin

# Optional: a merged clang profile for profile-guided optimisation
# (scripts\windows\pgo-train.ps1 makes one from your own runs).
# PGO_PROFILE=build\pgo\merged.profdata
