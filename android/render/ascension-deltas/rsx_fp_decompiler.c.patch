+            else snprintf(hi_txt, sizeof hi_txt, "(asuint(r[%u].%c) & 0xFFFF0000u)", index, comp[c]);
+            snprintf(line, sizeof line, "    r[%u].%c = asfloat(%s | %s);\n", index, comp[c], lo_txt, hi_txt);
+            out_puts(o, line);
+            lw[u0] = lw[u1] = 'B';
+        }
