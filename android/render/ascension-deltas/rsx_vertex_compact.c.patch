+#endif
+    for (; i < count; i++) {
+        const u8* p = src + (size_t)i * (is_u32 ? 4u : 2u);
+        const u32 index = is_u32
+            ? (((u32)p[0] << 24) | ((u32)p[1] << 16) | ((u32)p[2] << 8) | p[3])
