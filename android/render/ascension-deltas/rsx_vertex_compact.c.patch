+#if defined(RSX_VTX_AVX2)
+    if (rsx_vtx_fast_enabled())   /* LD_VTX_FAST: 16 / 8 indices a block first */
+        i = rsx_vtx_index_avx2(src, count, is_u32, stop_enabled, stop, out, &mn, &mx);
