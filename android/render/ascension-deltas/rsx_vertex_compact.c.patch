+static inline u32 rsx_compact_bswap32(u32 w)
+{
+#if defined(__GNUC__) || defined(__clang__)
+    return __builtin_bswap32(w);
+#else
+    return (w >> 24) | ((w >> 8) & 0xFF00u) | ((w << 8) & 0xFF0000u) | (w << 24);
+#endif
+}
