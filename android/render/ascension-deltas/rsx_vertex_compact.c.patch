+int rsx_vertex_fast_switch(void)
+{
+    if (rsx_vertex_fetch_fast < 0) {
+        const char* e = getenv("LD_VTX_FAST");
+        rsx_vertex_fetch_fast = !(e && *e == '0');
+    }
+    return rsx_vertex_fetch_fast > 0;
